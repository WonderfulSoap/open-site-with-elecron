{
  "name": "open-site-with-electron",
  "version": "1.0.0",
  "description": "Minimal Electron app that opens a URL from a startup argument.",
  "main": "main.js",
  "scripts": {
    "start": "env -u ELECTRON_RUN_AS_NODE electron .",
    "pack": "env -u ELECTRON_RUN_AS_NODE electron-builder --dir",
    "build:win": "env -u ELECTRON_RUN_AS_NODE electron-builder --win nsis --publish never",
    "build:linux": "env -u ELECTRON_RUN_AS_NODE electron-builder --linux AppImage --publish never"
  },
  "devDependencies": {
    "electron": "^30.5.1",
    "electron-builder": "^26.8.1"
  },
  "build": {
    "appId": "com.example.open-site-with-electron",
    "productName": "OpenSiteWithElectron",
    "files": [
      "main.js",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Utility"
    }
  }
}
